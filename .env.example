# Copy this file to .env and fill in the values.
# cp .env.example .env

# ── Kehitysasetukset ──────────────────────────────────────────────────────────

# Ohittaa JWT-roolipohjaisen pääsynhallinnan paikallisessa kehityksessä.
# Vaikuttaa vain, kun arvo on täsmälleen "true". Tuotannossa (NODE_ENV=production)
# asetus ohitetaan aina ja pääsynhallinta on päällä.
DISABLE_ROLE_BASED_ACCESS_CONTROL=true

# ── Autentikaatio ─────────────────────────────────────────────────────────────

# Käytetään JWT-tokenien allekirjoitukseen ja vahvistukseen.
# Tuotannossa: pitkä, satunnaisesti generoitu merkkijono.
JWT_SECRET_KEY=change-me-use-a-long-random-secret

# Pakollinen: Microsoft Entra ID (Azure AD) -sovellusrekisteröinti.
# auth-api hyväksyy vain id-tokenit, jotka on myönnetty tälle sovellukselle ESEDUn tenantissa.
# Samat arvot kuin frontendin VITE_CLIENT_ID ja VITE_TENANT_ID.
MS_TENANT_ID=
MS_CLIENT_ID=

# ── Sisäiset palvelu-URLit ────────────────────────────────────────────────────
# Docker-palveluiden nimet — älä muuta, ellei palvelun nimi docker-compose.yml:ssä muutu.

INTERNAL_AUTH_API_URL=http://auth-api:3000
INTERNAL_STUDENT_MANAGEMENT_API_URL=http://student-management-api:3000
INTERNAL_NOTIFICATION_SERVER_URL=http://notification-server:3000
INTERNAL_MESSAGING_SERVER_URL=http://messaging-server:3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────

INTERNAL_DB_HOSTNAME=db
INTERNAL_DB_PORT=5432
INTERNAL_DB_USERNAME=postgres
INTERNAL_DB_PASSWORD=postgres
INTERNAL_DB_DATABASE=postgres

# Prisman yhteysmerkkijono normaalille ajolle (Docker-palvelun hostname).
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres

# Prisman yhteysmerkkijono testitietokannan ajolle (erillinen db-test-kontti).
DATABASE_URL_TEST=postgresql://postgres:postgres@db-test:5432/postgres

# ── Magic-link-sähköposti (SMTP) ──────────────────────────────────────────────
# Paikalliseen kehitykseen: luo ilmainen testitili osoitteessa https://ethereal.email/
# Tuotannossa: oikeat SMTP-tunnukset.

APP_URL=localhost:5174
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
